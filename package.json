{
  "name": "booking_app_mac",
  "productName": "Booking",
  "version": "0.10.0",
  "description": "Booking outreach manager for macOS",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "floherzog",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite -c vite.web.config.mjs",
    "build:web": "vite build -c vite.web.config.mjs",
    "preview:web": "vite preview -c vite.web.config.mjs",
    "build": "node scripts/build-helper.mjs && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:core": "node scripts/bench-core.mjs",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.directories.output=\"$HOME/Builds/booking_app_mac\"",
    "clean:build": "node scripts/clean-build.mjs",
    "verify:csv": "node scripts/verify-csv-roundtrip.mjs",
    "dist:signed": "npm run build && electron-builder --mac -c.directories.output=\"$HOME/Builds/booking_app_mac\"",
    "build:helper": "node scripts/build-helper.mjs"
  },
  "dependencies": {
    "date-fns": "^4.3.0",
    "imapflow": "^1.7.7",
    "nodemailer": "^9.1.0",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.11",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/html": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "happy-dom": "^20.12.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
